# ──────────────────────────────────────────────────────────────────────────────
# Ume — environment. Copy to `.env` at the repo root. All three apps read it.
# ──────────────────────────────────────────────────────────────────────────────

# Public URL of the web app (no trailing slash)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Neon / Supabase / local). pg-boss (job queue) uses the same database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ume
# Optional: a direct (non-pooled) URL for the bot/worker + pg-boss. Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=

# Better Auth
BETTER_AUTH_SECRET=change-me-32-bytes-min-run-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Set to "true" only after enabling the privileged Message Content intent in the portal.
# Without it, "~" commands still work in DMs and slash commands work everywhere.
DISCORD_MESSAGE_CONTENT_INTENT=false
# Optional: register slash commands to one guild instantly while developing
DISCORD_DEV_GUILD_ID=

# Google OAuth (used for the CEO console and as an optional sign-in method)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CEO console: comma-separated Google emails allowed in. Nobody else can open /ceo.
CEO_EMAILS=billkawaka0@gmail.com

# Object storage (Cloudflare R2 recommended; any S3-compatible endpoint works)
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ume
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public domain for cover images
S3_PUBLIC_BASE_URL=

# Stripe (storage plans). Prices are created in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# Email (Resend). Without a key, emails are logged to stdout.
RESEND_API_KEY=
EMAIL_FROM="Ume <no-reply@ume.app>"

# Cron protection for /api/cron/* (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=change-me

# Worker
FFMPEG_PATH=ffmpeg
# yt-dlp binary (only used when the youtube_ingest feature flag is ON)
YTDLP_PATH=yt-dlp
# Optional cookies file for yt-dlp on datacenter IPs
YTDLP_COOKIES=

# Logging
LOG_LEVEL=info

# Public support links (optional)
NEXT_PUBLIC_DISCORD_SUPPORT_INVITE=
NEXT_PUBLIC_GITHUB_URL=https://github.com/odiwr/ume

# DMCA designated agent (shown on /dmca; must match your copyright.gov registration)
DMCA_AGENT_NAME=
DMCA_AGENT_EMAIL=dmca@ume.app
DMCA_AGENT_ADDRESS=
